          "showThinking": true,
          "showThinkingPreview": false,
          "showTools": false,
          "showToolsPreview": false
        }
      }
    }
  },
  {
    "version": "v1.0",
    "updateComponents": {
      "surfaceId": "eab-demo-surface",
      "components": [
        {
          "id": "root",
          "component": "Card",
          "child": "rootColumn",
          "backgroundColor": "#FFFFFFFF",
          "padding": 16,
          "cornerRadius": 12
        },
        {
          "id": "rootColumn",
          "component": "Column",
          "children": ["thinkingBlock", "toolBlock", "answer"],
          "gap": 10
        },
        {
          "id": "thinkingBlock",
          "component": "Column",
          "children": ["thinkingPanel", "thinkingPreview"],
          "gap": 4,
          "visible": { "path": "/ui/showThinking" }
        },
        {
          "id": "thinkingPanel",
          "component": "CollapsiblePanel",
          "title": "✦ 正在思考…",
          "variant": "reasoning",
          "defaultExpanded": false,
          "visible": { "path": "/ui/showThinking" },
          "children": ["thinkingText"],
          "fallbackMarkdown": "思考过程",
          "textEffect": "shimmer"
        },
        {
          "id": "thinkingText",
          "component": "Markdown",
          "content": { "path": "/thinking/text" }
        },
        {
          "id": "thinkingPreview",
          "component": "Text",
          "text": { "path": "/thinking/preview" },
          "maxLine": 1,
          "visible": { "path": "/ui/showThinkingPreview" }
        },
        {
          "id": "toolBlock",
          "component": "Column",
          "children": ["toolPanel", "toolsPreview"],
          "gap": 4,
          "visible": { "path": "/ui/showTools" }
        },
        {
          "id": "toolPanel",
          "component": "CollapsiblePanel",
          "title": "🛠️ 工具调用中…",
          "defaultExpanded": false,
          "visible": { "path": "/ui/showTools" },
          "children": ["toolText"],
          "fallbackMarkdown": "工具调用记录"
        },
        {
          "id": "toolText",
          "component": "Markdown",
          "content": { "path": "/tools/text" }
        },
        {
          "id": "toolsPreview",
          "component": "Text",
          "text": { "path": "/tools/preview" },
          "maxLine": 1,
          "visible": { "path": "/ui/showToolsPreview" }
        },
        {
          "id": "answer",
          "component": "Markdown",
          "content": { "path": "/answer/text" }
        }
      ]
    }
