{
  "name": "eab",
  "version": "2026.11.27",
  "private": true,
  "type": "module",
  "description": "EAB 企业智能体基座（Enterprise Agent Base）",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.16.1",
  "bin": {
    "eab": "./scripts/eab.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run --minWorkers=1 --maxWorkers=1",
    "test:watch": "vitest",
    "eval:agent": "tsx scripts/eval-agent.ts",
    "eval:kb": "tsx scripts/eval-kb.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm eval:agent && pnpm eval:kb",
    "verify:release": "pnpm verify",
    "smoke": "node scripts/smoke-http.mjs && node scripts/smoke-platform.mjs",
    "test:auth-redirect": "node scripts/auth-redirect.e2e.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:enforce": "node scripts/perf.mjs --enforce",
    "dev": "pnpm --filter @eab/server dev",
    "desktop": "pnpm --filter @eab/desktop start",
    "desktop:build": "pnpm --filter @eab/desktop build:win",
    "desktop:installer": "pnpm --filter @eab/desktop build:installer",
    "eab": "node scripts/eab.mjs",
    "server": "node scripts/eab.mjs server",
    "demo:kb": "tsx demo/kb-visibility.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
