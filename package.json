{
  "name": "eab",
  "version": "2026.11.14",
  "private": true,
  "type": "module",
  "description": "EAB 企业智能体基座（Enterprise Agent Base）",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.16.1",
  "bin": {
    "eab": "./scripts/eab.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test",
    "smoke": "node scripts/smoke-http.mjs && node scripts/smoke-platform.mjs",
    "test:auth-redirect": "node scripts/auth-redirect.e2e.mjs",
    "dev": "pnpm --filter @eab/server dev",
    "eab": "node scripts/eab.mjs",
    "server": "node scripts/eab.mjs server",
    "demo:kb": "tsx demo/kb-visibility.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
