# AGT-17 部署变量。复制为 .env 后按需修改；不要把真实密钥提交到仓库。
#
# 必填：控制台 API 令牌。生成方式示例：
#   openssl rand -hex 32   （Windows 可用 [guid]::NewGuid().ToString('N')）
EAB_CONSOLE_TOKEN=replace-with-a-long-random-token

# 可选：控制台超级管理员密码。留空则首次启动自动生成到 /data/admin-credentials.txt
EAB_ADMIN_PASSWORD=

# 单公司 ID，默认 c1
EAB_COMPANY_ID=c1

# 对外端口；被占用时改这里
EAB_PUBLIC_PORT=8787
EAB_PUBLIC_ADMIN_PORT=8788

EAB_LOG_LEVEL=warn
